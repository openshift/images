FROM registry.access.redhat.com/ubi9/ubi:latest AS builder

# Preserve OS identification for scanners and empty /etc/pki directories for secrets.
RUN mkdir -p /rootfs /tmp/release-files && \
    dnf --installroot=/rootfs --releasever=9 \
        --disablerepo='*' \
        --enablerepo=ubi-9-baseos-rpms --enablerepo=ubi-9-appstream-rpms \
        --setopt=gpgcheck=1 \
        --setopt=install_weak_deps=False --setopt=tsflags=nodocs \
        install -y filesystem setup tzdata && \
    cp -a /rootfs/etc/redhat-release /rootfs/usr/lib/os-release /tmp/release-files/ && \
    cp -a /rootfs/etc/os-release /tmp/release-files/etc-os-release && \
    rpm --root /rootfs -qa --qf '%{NAME}\n' | \
        grep -Ev '^(filesystem|setup|tzdata|gpg-pubkey)$' \
        > /tmp/remove-packages && \
    xargs -r rpm --root /rootfs -e --nodeps --noscripts < /tmp/remove-packages && \
    cp -a /tmp/release-files/etc-os-release /rootfs/etc/os-release && \
    cp -a /tmp/release-files/redhat-release /rootfs/etc/redhat-release && \
    cp -a /tmp/release-files/os-release /rootfs/usr/lib/os-release && \
    rm -rf /rootfs/var/cache/dnf /rootfs/var/lib/dnf \
        /rootfs/var/log/* /rootfs/usr/share/licenses /rootfs/etc/pki && \
    mkdir -p /rootfs/etc/pki/ca-trust/extracted/edk2 \
             /rootfs/etc/pki/ca-trust/extracted/java \
             /rootfs/etc/pki/ca-trust/extracted/openssl \
             /rootfs/etc/pki/ca-trust/extracted/pem/directory-hash \
             /rootfs/etc/pki/java \
             /rootfs/etc/pki/tls/certs && \
    test ! -e /rootfs/bin/bash && \
    test ! -e /rootfs/lib64/libc.so.6 && \
    test -s /rootfs/etc/redhat-release && \
    test -s /rootfs/usr/lib/os-release && \
    test -z "$(find /rootfs/etc/pki -mindepth 1 ! -type d -print -quit)"

FROM scratch
COPY --from=builder /rootfs/ /

LABEL cpe="cpe:/a:redhat:enterprise_linux:9::appstream" \
      vendor="Red Hat, Inc." \
      distribution-scope="public" \
      com.redhat.license_terms="https://www.redhat.com/en/about/red-hat-end-user-license-agreements#UBI" \
      io.openshift.tags="openshift,base,static,rhel9" \
      io.k8s.display-name="OpenShift Static Base (no CA)" \
      io.k8s.description="This is the base image for static OpenShift images that mount their own CA trust."
